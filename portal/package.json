{
  "name": "sosp-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Portal do Cidadão e Back-office do Sistema de Orientação para Serviços Públicos (SOSP)",
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/verify-build-env.mjs",
    "build": "next build",
    "prebuild:cloudflare": "node scripts/verify-build-env.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "VITEST_SKIP_INSTALL_CHECKS=1 vitest run",
    "test:watch": "VITEST_SKIP_INSTALL_CHECKS=1 vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
