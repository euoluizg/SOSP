# ==============================================================================
# SOSP — Exemplo de Variáveis de Ambiente (.env.example)
# Referência completa: docs/05-engineering-devops.md (§2) e ADR-001 a ADR-008
# ==============================================================================

# --- Ambiente e Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
# Defina uma chave aleatória segura com no mínimo 50 caracteres (ex.: secrets.token_urlsafe(50))
SECRET_KEY=""
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Estratégia de Repositório de Persistência (ADR-001 / Etapa 3) ---
# 'memory' (padrão seguro para desenvolvimento offline/CI) ou 'orm' (PostgreSQL real)
REPOSITORY_BACKEND=memory

# --- Chave HMAC de Segurança de Contexto PostgreSQL RLS (ADR-003, Etapa 4D.2) ---
# Obrigatória em modo REPOSITORY_BACKEND=orm (mínimo 32 caracteres criptográficos, NUNCA igual ao SECRET_KEY)
DB_HMAC_SECRET_KEY=""

# --- Banco de Dados Multi-ambiente (ADR-002, ADR-008) ---
# 'sqlite3' (padrão offline) ou 'postgresql' (local ou Supabase Session Pooler)
DB_ENGINE=sqlite3
DB_NAME=sosp_local
DB_USER=sosp_runtime_app
DB_PASSWORD=""
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30000
DB_CONN_MAX_AGE=0
DB_REMOTE_REQUIRED=false

# --- Cache e Fila Assíncrona (Redis 7 / Celery — ADR-005) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Armazenamento de Arquivos (S3 / MinIO — ADR-006) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_ATTACHMENTS=sosp-attachments-private
S3_BUCKET_EXPORTS=sosp-exports-private
S3_REGION=sa-east-1
S3_PRESIGNED_URL_TTL_SECONDS=300
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Autenticação e Sessão (RF-01 / RF-02 / ADR-003) ---
SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=300
PASSWORD_RECOVERY_CODE_TTL_SECONDS=900

# --- Integrações Externas (ViaCEP / IBGE / E-mail) ---
VIACEP_BASE_URL=https://viacep.com.br/ws
IBGE_LOCALIDADES_URL=https://servicodados.ibge.gov.br/api/v1/localidades
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_DEFAULT_FROM=nao-responda@sosp.gov.br

# --- Gov.br OIDC (Previsto para v2.0 — desabilitado no MVP) ---
GOVBR_OIDC_ENABLED=false
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=http://localhost:3000/api/auth/callback/govbr

# --- Feature Flags (ADR-007) ---
# Fora do MVP (desligadas por padrão):
FEATURE_REVIEWS_ENABLED=false
FEATURE_PUSH_ENABLED=false
FEATURE_SMS_ENABLED=false
FEATURE_WHATSAPP_ENABLED=false
# Entregues no MVP (ligadas por padrão):
FEATURE_PDF_ASYNC_ENABLED=true
FEATURE_REPORTS_EXPORT=true

# --- Portal Next.js (portal/) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
