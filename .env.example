# ==============================================================================
# SOSP — Exemplo de Variáveis de Ambiente (.env.example)
# Referência completa: docs/05-engineering-devops.md (§2) e ADR-007 / ADR-008
# ==============================================================================

# --- Ambiente e Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=troque-por-chave-aleatoria-com-50-caracteres-no-minimo
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Banco de Dados (PostgreSQL 17 / Supabase — ADR-008) ---
# Conexão do pooler transacional/sessão para a aplicação:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sosp
# Conexão direta (porta 5432) usada exclusivamente para migrate, pg_dump e restore:
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/sosp

# --- Cache e Fila Assíncrona (Redis 7 / Celery — ADR-005) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Armazenamento de Arquivos (S3 / MinIO — ADR-006) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_ATTACHMENTS=sosp-attachments-private
S3_BUCKET_EXPORTS=sosp-exports-private
S3_REGION=sa-east-1
S3_PRESIGNED_URL_TTL_SECONDS=300
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Autenticação e Sessão (RF-01 / RF-02 / ADR-003) ---
SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=300
PASSWORD_RECOVERY_CODE_TTL_SECONDS=900

# --- Integrações Externas (ViaCEP / IBGE / E-mail) ---
VIACEP_BASE_URL=https://viacep.com.br/ws
IBGE_LOCALIDADES_URL=https://servicodados.ibge.gov.br/api/v1/localidades
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_DEFAULT_FROM=nao-responda@sosp.gov.br

# --- Gov.br OIDC (Previsto para v2.0 — desabilitado no MVP) ---
GOVBR_OIDC_ENABLED=false
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=http://localhost:3000/api/auth/callback/govbr

# --- Feature Flags (ADR-007) ---
# Fora do MVP (desligadas por padrão):
FEATURE_REVIEWS_ENABLED=false
FEATURE_PUSH_ENABLED=false
FEATURE_SMS_ENABLED=false
FEATURE_WHATSAPP_ENABLED=false
# Entregues no MVP (ligadas por padrão):
FEATURE_PDF_ASYNC_ENABLED=true
FEATURE_REPORTS_EXPORT=true

# --- Portal Next.js (portal/) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

