# =============================================================================
# SOSP — Exemplo de Variáveis de Ambiente para o Backend Django
# =============================================================================

# Django Core
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Mecanismo de Banco de Dados:
# 'sqlite3' (padrão em memória para testes offline) ou 'postgresql' (local ou Supabase)
DB_ENGINE=sqlite3

# Configurações do PostgreSQL Local / Homologação (quando DB_ENGINE=postgresql)
DB_NAME=sosp_local
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0

# Opções Avançadas de Conexão:
# DB_SSLMODE: 'disable' (local), 'require' (nuvem/Supabase)
DB_SSLMODE=disable

# Pooler de Transação do Supabase (PgBouncer/Supavisor na porta 6543):
# Em conexões pooler transacional, desative cursores do lado do servidor:
DB_DISABLE_SERVER_SIDE_CURSORS=false

# Estratégia de Persistência de Dados:
# 'memory' (repositórios simulados em memória) ou 'orm' (PostgreSQL real via Django ORM)
REPOSITORY_BACKEND=memory

# Feature Flags (ADR-007)
FEATURE_REVIEWS_ENABLED=false
FEATURE_PUSH_ENABLED=false
FEATURE_SMS_ENABLED=false
FEATURE_WHATSAPP_ENABLED=false
FEATURE_REPORTS_EXPORT=true
