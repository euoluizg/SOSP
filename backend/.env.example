# =============================================================================
# SOSP — Exemplo de Variáveis de Ambiente para o Backend Django (Etapa 4A)
# =============================================================================
# IMPORTANTE:
# - NUNCA versione credenciais reais, senhas ou tokens neste repositório.
# - O arquivo real '.env' deve permanecer protegido pelo .gitignore.
# - Para ambientes remotos, consulte o Runbook: docs/database/supabase-connection-runbook.md
# =============================================================================

# Django Core
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Mecanismo de Banco de Dados:
# 'sqlite3' (padrão em memória para testes offline e CI) ou 'postgresql' (local ou Supabase)
DB_ENGINE=sqlite3

# Estratégia de Repositório de Persistência (ADR-001):
# 'memory' (mock em memória retrocompatível) ou 'orm' (PostgreSQL real via Django ORM)
REPOSITORY_BACKEND=memory

# =============================================================================
# CONFIGURAÇÕES POSTGRESQL (quando DB_ENGINE=postgresql)
# =============================================================================

# --- CENÁRIO 1: PostgreSQL Local Isolado (desenvolvimento offline) ---
# DB_NAME=sosp_local
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_DISABLE_SERVER_SIDE_CURSORS=false
# REPOSITORY_BACKEND=orm

# --- CENÁRIO 2 (MODALIDADE A): Conexão Direta Supabase (DDL / Migrations) ---
# ATENÇÃO: No plano Free, a conexão direta exige conectividade de rede IPv6.
# Obtenha o host exato no modal "Connect" do Dashboard do Supabase (ex.: db.xxxx.supabase.co).
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=db.exemplo-do-projeto.supabase.co
# DB_PORT=5432
# DB_SSLMODE=require
# DB_REMOTE_REQUIRED=true
# DB_DISABLE_SERVER_SIDE_CURSORS=false
# REPOSITORY_BACKEND=orm

# --- CENÁRIO 3 (MODALIDADE B - RECOMENDADA): Session Pooler Supabase (IPv4 / Render) ---
# Recomendada para backend persistente Django e migrations em redes sem IPv6 (ex.: Render).
# Porta 5432 no host do pooler. O usuário inclui o project ref (ex.: postgres.xxxx).
# DB_NAME=postgres
# DB_USER=postgres.exemplo-project-ref
# DB_PASSWORD=
# DB_HOST=pooler-host-obtido-no-dashboard.supabase.com
# DB_PORT=5432
# DB_SSLMODE=require
# DB_REMOTE_REQUIRED=true
# DB_DISABLE_SERVER_SIDE_CURSORS=false
# REPOSITORY_BACKEND=orm

# --- CENÁRIO 4 (MODALIDADE C): Transaction Pooler Supabase (IPv4 / Porta 6543) ---
# Alternativa para pools com alto volume stateless. Desativa cursores server-side automaticamente.
# NÃO UTILIZAR para rodar migrations DDL.
# DB_NAME=postgres
# DB_USER=postgres.exemplo-project-ref
# DB_PASSWORD=
# DB_HOST=pooler-host-obtido-no-dashboard.supabase.com
# DB_PORT=6543
# DB_SSLMODE=require
# DB_REMOTE_REQUIRED=true
# DB_DISABLE_SERVER_SIDE_CURSORS=true
# REPOSITORY_BACKEND=orm

# Opções de Gerenciamento de Conexões e Timeouts:
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30000

# Feature Flags (ADR-007)
FEATURE_REVIEWS_ENABLED=false
FEATURE_PUSH_ENABLED=false
FEATURE_SMS_ENABLED=false
FEATURE_WHATSAPP_ENABLED=false
FEATURE_REPORTS_EXPORT=true
